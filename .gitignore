.next/
.svelte-kit/
.nuxt/
out/
*.tsbuildinfo
.turbo/

# SvelteKit specific
/build
/package
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright artifacts (svelte-worker visual verification: screenshots,
# traces, videos). These are attached to PRs out-of-band and never
# committed.
.playwright-artifacts/
playwright-report/
test-results/

