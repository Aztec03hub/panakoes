# ============================================================================
# Local Claude / agent artifacts
# ============================================================================
.claude/.local/
.agent-state/
.agent-runs/*.md
.agent-runs/*.json
.agent-runs/*.progress.log
!.agent-runs/README.md

# ============================================================================
# OS Image artifacts (Packer output)
# ============================================================================
packer_cache/
*.box

# Packer build inputs may include presigned S3 URLs and other sensitive
# build-time configuration. Variable definitions stay outside source
# control; documented operator runbook tells the operator how to construct
# them per bake. See infra/ami/gpu-transcribe/README.md.
infra/ami/**/*.pkrvars.hcl
infra/ami/**/*.auto.pkrvars.hcl

# ============================================================================
# Database snapshots
# ============================================================================
*.sqlite
*.sqlite3
*.db
dump.rdb

# ============================================================================
# Local-only session artifacts (do NOT commit to the public repo)
# ============================================================================
# Exported conversation logs migrated between Claude sessions. Contain
# verbatim prompts, full subagent transcripts, and stray em-dashes from
# upstream tooling. Local-only by design.
PANAKOES_CONVERSATION_LOG.md
PANAKOES_CONVERSATION_LOG*.md
*.session-log.md
# Stray Terraform plan binaries from local plan runs (the existing `tfplan`
# rule near the top only catches the extensionless form).
infra/**/tfplan.bin
*.tfplan.bin
