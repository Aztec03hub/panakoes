# ============================================================================
# Operating System
# ============================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ============================================================================
# IDEs and Editors
# ============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# ============================================================================
# Secrets and credentials (NEVER commit)
# ============================================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json
service-account-*.json
.aws/credentials
.aws/config

# ============================================================================
# Terraform (state contains secrets and infra topology)
# ============================================================================
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform/
# Plans generated by scripts/tf.sh; never commit (contains literal AWS resource
# IDs, can leak credentials in some plans, and bloats the repo with binary noise).
tfplan
*.tfplan
# Lambda deployment artifacts emitted by archive_file data sources in
# infra/dev/*/. The .zip is regenerated from the inline source on every
# `terraform plan`; committing it would bloat the repo and trigger
# pointless diffs on every machine.
infra/dev/**/stub_lambda.zip
# .terraform.lock.hcl IS committed: it pins provider versions and checksums
# for reproducibility. Without it, terraform init can pick different versions
# on different machines and cause drift.
*.tfvars
!*.tfvars.example
!terraform.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so
.Python
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Python testing and coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# Python type-checking and linting
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json

# Python virtual environments
venv/
.venv/
env/
ENV/
.python-version
# Per-service `.python-version` files are tracked (each service pins its
# Python version explicitly so uv resolves the same toolchain everywhere).
!services/*/.python-version

# uv / poetry
.uv/
poetry.toml

