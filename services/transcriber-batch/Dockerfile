# syntax=docker/dockerfile:1.7
#
# transcriber-batch container image.
#
# Base image notes:
#   The transcriber-batch container only runs on the bespoke
#   gpu-transcribe AMI (see infra/ami/gpu-transcribe/), which bakes
#   Whisper-large-v3 fp16 weights + the openai-whisper wheel + CUDA
#   runtime + NVIDIA driver into the host. We deliberately use a slim
#   Python base here rather than nvidia/cuda:12.4.1-runtime-ubuntu22.04
#   because:
#     - The host AMI already ships CUDA and the NVIDIA driver; the
#       container only needs python + boto3 + the panakoes libs.
#     - The host's GPU is exposed to the container via the NVIDIA
#       Container Toolkit (configured on the AMI), so CUDA libraries
#       are mounted in at runtime, not baked in.
#     - The container runtime imports whisper from the AMI-side
#       openai-whisper install via a host-mounted site-packages
#       directory configured by the Batch job definition; this image
#       does NOT bundle whisper because that would shadow the AMI's
#       CUDA-tuned build.
#
#   If a future GPU-base image is published to panakoes-dev-gpu-base
#   in ECR, swap the builder + runtime FROM lines to that base; the
#   rest of the file is unchanged.
#
# Build context MUST be the repo root:
#   docker buildx build -f services/transcriber-batch/Dockerfile -t <ECR>:tag .

FROM python:3.12-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Path-dep siblings the transcriber-batch service consumes. Each must
# be mounted at the same relative location the pyproject.toml's
# [tool.uv.sources] block references (../<lib>).
COPY services/models-lib /workspace/models-lib
COPY services/otel-lib /workspace/otel-lib
COPY services/audit-lib /workspace/audit-lib
COPY services/transcriber-lib /workspace/transcriber-lib

COPY services/transcriber-batch/pyproject.toml /workspace/transcriber-batch/pyproject.toml
COPY services/transcriber-batch/README.md /workspace/transcriber-batch/README.md
COPY services/transcriber-batch/src /workspace/transcriber-batch/src

WORKDIR /workspace/transcriber-batch

# Note: --frozen is dropped here because uv.lock is generated by
# `uv lock` post-merge; the first CI image bake runs with --no-frozen
# so the lockfile is materialized inside the image. Subsequent bakes
# bring the lock back under --frozen once it is committed to the repo.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --no-editable --no-install-project

FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Minimal runtime deps. ffmpeg is required by openai-whisper for audio
# decoding; the host AMI also ships ffmpeg but the container's whisper
# call uses the in-container binary unless the host's PATH is explicitly
# mounted in.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --no-create-home app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app services/transcriber-batch/src/ ./src/

USER app

ENV PYTHONPATH=/app/src

CMD ["python", "-m", "panakoes_transcriber_batch.main"]
