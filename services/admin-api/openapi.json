    },
    "/api/v1/admin/ingestions/{ingestion_id}/force-fail": {
      "post": {
        "description": "Force-fail a stuck or abusive ingestion record.\n\nConfirmation template: `FAIL <ingestion_id>`. The operator must\ntype this string verbatim before the operation can fire.\n\nMarks the row in `panakoes-dev-ingestion` as `failed`, attaching\na failure reason and `failure_source = \"tier3.force-fail-ingestion\"`\nso post-incident reconciliation can distinguish operator-driven\nfailures from pipeline-driven failures.",
        "operationId": "force_fail_ingestion_api_v1_admin_ingestions__ingestion_id__force_fail_post",
        "parameters": [
          {
            "in": "path",
            "name": "ingestion_id",
            "required": true,
            "schema": {
              "title": "Ingestion Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Force Fail Ingestion",
        "tags": [
          "lifecycle"
        ]
      }
    },
