    "/api/v1/admin/users/{user_id}/block-sessions": {
      "post": {
        "description": "Bulk-terminate every active streaming session for a user.\n\nConfirmation template: `BLOCK USER <user_id>`. The operator must\ntype this string verbatim before the operation can fire.\n\nImplements \"kick this user out NOW\" incident response: queries the\nUserSessionsIndex GSI for the user's sessions, then issues a\nconditional UpdateItem against each `active` / `starting` /\n`paused` row marking it as `errored` with a `termination_source =\n\"tier3.block-user-sessions\"` tag. Already-terminated sessions are\nskipped.\n\nPartial-failure shape: if updating session N succeeds but session\nN+1 fails, the operation surfaces a `failed` envelope with the\npartial-completion count visible in the audit row. Already-blocked\nsessions stay blocked (we do NOT roll back; a ghost session is\nsafer than an unkilled one).",
        "operationId": "block_user_sessions_api_v1_admin_users__user_id__block_sessions_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Block User Sessions",
        "tags": [
          "lifecycle"
        ]
      }
    },
