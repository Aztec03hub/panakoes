# Panakoes admin SPA build-time environment.
#
# Vite inlines every `VITE_*` variable at build time. None of these are
# secrets (they only configure which public endpoints the SPA talks to);
# the SPA is a fully-static bundle and ships them in the JS to every
# browser that loads the dashboard.
#
# Copy to `.env.development` (gitignored) for local overrides, or set
# them at build time in CI to bake a production-pointed bundle.

# --- API base URL --------------------------------------------------------
# Origin (no trailing slash) of the API Gateway in front of cost-api +
# admin-api + auth. The SPA appends `/v1/<service>/<path>` per ADR-038's
# c+ routing shape.
#
# Local dev with Vite proxy: leave unset (empty string falls back to
# relative paths, which Vite proxies via `server.proxy`).
# Dev environment (current): the API Gateway HTTP API URL.
# Prod: replace with the api.panakoes.com custom domain once it ships.
VITE_API_BASE_URL=https://n2un8ica69.execute-api.us-east-1.amazonaws.com/dev

# --- Feature flags -------------------------------------------------------
# Default `true`: the dashboard fetches health + per-service detail from
# the live health-aggregator service. Set explicitly to `false` to fall
# back to the bundled static mock at /dashboard/health.json and the
# per-service detail mocks under /dashboard/<service>.json. Useful for
# offline development. See ADR-038 + the "Tier 1 read-only health"
# milestone in SCOPE.md.
VITE_USE_LIVE_HEALTH_AGGREGATOR=true

# --- Observability (OpenTelemetry) ---------------------------------------
# OTLP/HTTP endpoint for the browser-side OpenTelemetry exporter. When
# unset (the default), the SDK boots in no-op mode, logs a single info
# message at boot, and emits zero network traffic. Set this to your
# local ADOT / OTEL collector ingress (typically `http://localhost:4318/v1/traces`)
# for dev, or to the deployed collector URL in production.
#
# Other resource attributes (`service.version`, `deployment.environment`)
# are sourced from `VITE_SERVICE_VERSION` and `VITE_DEPLOYMENT_ENVIRONMENT`
# respectively; both default to `0.0.0` / `dev` when unset. The
# `service.name` is pinned to `admin` and `service.namespace` to
# `panakoes` in `src/lib/otel.ts`.
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
# VITE_SERVICE_VERSION=
# VITE_DEPLOYMENT_ENVIRONMENT=dev
