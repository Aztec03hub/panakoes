# Panakoes admin SPA build-time environment.
#
# Vite inlines every `VITE_*` variable at build time. None of these are
# secrets (they only configure which public endpoints the SPA talks to);
# the SPA is a fully-static bundle and ships them in the JS to every
# browser that loads the dashboard.
#
# Copy to `.env.development` (gitignored) for local overrides, or set
# them at build time in CI to bake a production-pointed bundle.

# --- API base URL --------------------------------------------------------
# Origin (no trailing slash) of the API Gateway in front of cost-api +
# admin-api + auth. The SPA appends `/v1/<service>/<path>` per ADR-038's
# c+ routing shape.
#
# Local dev with Vite proxy: leave unset (empty string falls back to
# relative paths, which Vite proxies via `server.proxy`).
# Dev environment (current): the API Gateway HTTP API URL.
# Prod: replace with the api.panakoes.com custom domain once it ships.
VITE_API_BASE_URL=https://n2un8ica69.execute-api.us-east-1.amazonaws.com/dev

# --- Feature flags -------------------------------------------------------
# Flip to `true` once the health-aggregator service ships. While `false`,
# the dashboard fetches the bundled static mock at /dashboard/health.json
# (served by SvelteKit's static asset pipeline) and the per-service
# detail mocks under /dashboard/<service>.json. See ADR-038 + the
# "Tier 1 read-only health" milestone in SCOPE.md.
VITE_USE_LIVE_HEALTH_AGGREGATOR=false
