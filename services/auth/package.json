{
  "name": "@panakoes/auth",
  "version": "0.1.0",
  "description": "Auth microservice for Panakoes (Better-Auth + Hono + Drizzle)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.0.2",
    "better-auth": "1.6.9",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.18",
    "jose": "6.2.3",
    "otpauth": "9.5.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@testcontainers/postgresql": "10.16.0",
    "@types/node": "22.10.1",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-kit": "0.31.10",
    "testcontainers": "10.16.0",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "cpu-features", "esbuild", "ssh2"]
  }
}
