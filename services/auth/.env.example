# Panakoes Auth service env vars
# Copy this to `.env` for local development. Real values come from AWS Secrets
# Manager / SSM Parameter Store at runtime in non-local environments.

# HTTP server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Postgres connection string. Local dev points at a docker-compose Postgres;
# tests use testcontainers and inject this at runtime.
DATABASE_URL=postgres://panakoes:panakoes@localhost:5432/panakoes_auth

# JWT signing. AUTH_JWT_SECRET MUST be at least 32 bytes and is rotated via
# AWS Secrets Manager in production. Service refuses to boot if the value is
# missing or too short. Generate one locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-me-with-a-32-byte-or-longer-random-secret-value
AUTH_JWT_ISSUER=https://auth.panakoes.com
AUTH_JWT_AUDIENCE=panakoes-api
AUTH_JWT_EXPIRES_IN_SECONDS=3600

# Better-Auth base URL (used for cookies / callback URL construction)
BETTER_AUTH_URL=http://localhost:8080
