#!/usr/bin/env bash
# pre-push hook: catch-the-silly-stuff-fast local gate before every push.
#
# Why this exists:
#   Remote CI takes 3-5 minutes per push; catching a broken workflow YAML,
#   a leaked secret, an em-dash, or unformatted Terraform locally saves
#   that round-trip every time it fires. The hook runs `make ci-fast`
#   (sub-90-second focused gate) so the cost of pushing is essentially
#   zero. Heavier checks (pytest, vitest, mypy, full pre-commit-all) live
#   server-side where wall-clock does not block the dev's push.
#
# Strategy:
#   1. NO_VERIFY=1 short-circuits everything (escape hatch for cases where
#      the relevant gates were already run another way).
#   2. CI_FULL=1 runs the full ci-pr behavior (the prior pre-push gate);
#      use it before tagging a release or when in doubt.
#   3. Prefer `make ci-fast` (the new sub-90s focused gate).
#   4. Fall back to `make ci-pr` then `make ci-local` for older branches
#      where ci-fast isn't on the branch yet. Once a branch with the new
#      target merges, this fallback path goes cold.
#   5. If none of the targets exist, warn and let the push through.
#
# Wallclock budget:
#   ci-fast targets sub-90s, so we cap the entire hook at 120s by default.
#   The override env var (_PREPUSH_TIMEOUT_S) is also the test seam used
#   by tests/hooks/test_pre_push.sh. Server-side CI is the canonical
#   merge gate; if a check is slow, push it server-side rather than
#   re-inflate this hook past 90s.
#   See feedback_ci_fast_pre_push.md.
#
# Install: scripts/install-githooks.sh (or `make install-hooks`).

set -euo pipefail

if [ "${NO_VERIFY:-0}" = "1" ]; then
  echo "[pre-push] WARNING: NO_VERIFY=1 set, SKIPPING pre-push checks." >&2
  echo "[pre-push] Server-side CI is your only gate. Hope you know what you're doing." >&2
  exit 0
fi

PREPUSH_TIMEOUT_S="${_PREPUSH_TIMEOUT_S:-120}"

# Allow tests / harnesses to inject a fake `make`. Defaults to the real
# binary on PATH. Keep this as a single token so shellcheck stays happy.
MAKE_BIN="${_PREPUSH_MAKE_BIN:-make}"

# Prefer ci-fast (sub-90s focused gate). CI_FULL=1 forces the full ci-pr.
# Fall back to ci-pr then ci-local for branches predating ci-fast.
if [ "${CI_FULL:-0}" = "1" ] && "$MAKE_BIN" -n ci-full >/dev/null 2>&1; then
  TARGET="ci-full"
  PREPUSH_TIMEOUT_S="${_PREPUSH_TIMEOUT_S:-480}"
elif [ "${CI_FULL:-0}" = "1" ] && "$MAKE_BIN" -n ci-pr >/dev/null 2>&1; then
  TARGET="ci-pr"
  PREPUSH_TIMEOUT_S="${_PREPUSH_TIMEOUT_S:-480}"
elif "$MAKE_BIN" -n ci-fast >/dev/null 2>&1; then
  TARGET="ci-fast"
elif "$MAKE_BIN" -n ci-pr >/dev/null 2>&1; then
  TARGET="ci-pr"
  PREPUSH_TIMEOUT_S="${_PREPUSH_TIMEOUT_S:-480}"
elif "$MAKE_BIN" -n ci-local >/dev/null 2>&1; then
  TARGET="ci-local"
  PREPUSH_TIMEOUT_S="${_PREPUSH_TIMEOUT_S:-480}"
else
  echo "[pre-push] WARN: no ci-fast / ci-pr / ci-local target on this branch."
  echo "[pre-push] Skipping the gate. Once a branch with these targets merges, the hook re-arms."
  exit 0
fi

# Log file kept per-push so failures point the operator at a concrete path
# they can inspect with their tool of choice (less, $EDITOR, grep). We
# explicitly do NOT pipe the run through `tail -N` because that buffers
# all stdin until pipe close and would swallow the live output stream.
# See feedback_never_pipe_through_tail_in_background_bash.
LOG_DIR="${TMPDIR:-/tmp}"
LOG_FILE="${LOG_DIR}/panakoes-prepush-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"

echo "[pre-push] Running 'make $TARGET' before push (budget: ${PREPUSH_TIMEOUT_S}s wallclock)..."
echo "[pre-push] Streaming output below; full log: $LOG_FILE"
echo "[pre-push] Bypass with: NO_VERIFY=1 git push"
echo ""

# `timeout` returns 124 when it kills the child; we trap that
# specifically so the operator sees the actionable budget message rather
# than a bare non-zero. `tee` keeps the operator's terminal live AND
# persists the full log to disk for post-mortem.
set +e
timeout "$PREPUSH_TIMEOUT_S" "$MAKE_BIN" "$TARGET" 2>&1 | tee "$LOG_FILE"
# Use PIPESTATUS to get make's exit code through the tee pipe.
rc="${PIPESTATUS[0]}"
set -e

if [ "$rc" -eq 124 ]; then
  echo "" >&2
  echo "[pre-push] FAILED: pre-push '$TARGET' exceeded ${PREPUSH_TIMEOUT_S}s budget; relying on server-side CI. Override with NO_VERIFY=1, or run CI_FULL=1 git push if you need the heavier gate locally." >&2
  echo "[pre-push] Full log: $LOG_FILE" >&2
  exit 1
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "[pre-push] FAILED: 'make $TARGET' exited $rc. Push aborted." >&2
  echo "[pre-push] Full log: $LOG_FILE" >&2
  echo "[pre-push] Inspect with: less '$LOG_FILE'  (or your editor of choice)" >&2
  echo "[pre-push] Fix the failures above, then 'git push' again." >&2
  echo "[pre-push] To bypass (emergency only): NO_VERIFY=1 git push" >&2
  exit "$rc"
fi

echo ""
echo "[pre-push] OK: $TARGET passed. Pushing."
